{
  "pack": ".devteam/pack",
  "agent": {
    "runtime": "opencode",
    "command": "opencode",
    "args": [
      "run",
      "--format",
      "json",
      "--dir",
      "{dir}",
      "{prompt}"
    ],
    "discussArgs": [
      "--agent",
      "plan",
      "--prompt",
      "{prompt}"
    ],
    "model": "opencode-go/deepseek-v4.1-flash",
