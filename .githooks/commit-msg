#!/bin/sh
# commit-msg hook — validate conventional commit format

MSG=$(cat "$1")

# Skip validation for merge commits
if echo "$MSG" | head -1 | grep -qE "^Merge "; then
  exit 0
fi

# Skip validation for WIP commits on feature branches
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
if echo "$MSG" | head -1 | grep -qE "^WIP:" && echo "$BRANCH" | grep -qE "^feature/"; then
  exit 0
fi

# Validate conventional commit format
if ! echo "$MSG" | head -1 | grep -qE "^(feat|fix|refactor|docs|test|chore|hotfix|ci|style|perf|revert)(\(.+\))?: .{1,}"; then
  echo "ERROR: Invalid commit message format."
  echo ""
  echo "Expected: <type>(<scope>): <description>"
  echo ""
  echo "Types: feat, fix, refactor, docs, test, chore, hotfix, ci, style, perf, revert"
  echo ""
  echo "Examples:"
  echo "  feat(payment): add import functionality"
  echo "  fix(invoice): correct rounding error"
  echo "  refactor(order): extract validation logic"
  echo "  docs(api): update endpoint documentation"
  echo "  test(auth): add login regression tests"
  echo ""
  echo "Your message:"
  echo "  $MSG"
  exit 1
fi

exit 0
